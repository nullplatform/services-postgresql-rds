#!/bin/bash
set -euo pipefail

metric_config() {
  case "$1" in
  CPUUtilization) UNIT=percent STATISTIC=Average ;;
  DatabaseConnections) UNIT=count STATISTIC=Maximum ;;
  FreeStorageSpace) UNIT=bytes STATISTIC=Minimum ;;
  FreeableMemory) UNIT=bytes STATISTIC=Minimum ;;
  ReadIOPS) UNIT=count STATISTIC=Average ;;
  WriteIOPS) UNIT=count STATISTIC=Average ;;
  ReadLatency) UNIT=seconds STATISTIC=Average ;;
  WriteLatency) UNIT=seconds STATISTIC=Average ;;
  *) return 1 ;;
  esac
}

iso_seconds_ago() {
  local seconds="$1" epoch
  epoch=$(($(date -u +%s) - seconds))
  date -u -d "@${epoch}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ
}

require_timestamp() {
  local name="$1" value="$2"
  if [[ ! "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|\+00:00)$ ]]; then
    echo "ERROR: ${name} '${value}' is not a UTC ISO 8601 timestamp." >&2
    exit 1
  fi
}

aws_profile_from_values() {
  local line
  if [ ! -r "${VALUES:-}" ]; then
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^aws_profile:[[:space:]]*\"?([^\"]*)\"?[[:space:]]*$ ]]; then
      echo "${BASH_REMATCH[1]}"
      return 0
    fi
  done <"$VALUES"
}

eval "$(printf '%s' "$CONTEXT" | jq -r '
  (.arguments // {}) as $arguments
  | ($arguments.service.attributes // {}) as $attributes
  | @sh "METRIC=\($arguments.metric // "" | tostring)
START_TIME=\($arguments.start_time // "" | tostring)
END_TIME=\($arguments.end_time // "" | tostring)
REQUESTED_PERIOD=\($arguments.period // "" | tostring)
DB_INSTANCE_IDENTIFIER=\($attributes.db_instance_identifier // "" | tostring)
REGION=\($attributes.hostname // "" | tostring | split(".") | .[2] // "")"')"

if ! metric_config "$METRIC"; then
  echo "ERROR: unknown metric '${METRIC}'." >&2
  exit 1
fi

PERIOD=60
if [[ "$REQUESTED_PERIOD" =~ ^[0-9]+$ ]] && [ "$REQUESTED_PERIOD" -gt 60 ]; then
  PERIOD=$(((REQUESTED_PERIOD + 59) / 60 * 60))
fi

if [ -z "$START_TIME" ] || [ -z "$END_TIME" ]; then
  START_TIME=$(iso_seconds_ago 3600)
  END_TIME=$(iso_seconds_ago 0)
fi
require_timestamp start_time "$START_TIME"
require_timestamp end_time "$END_TIME"

if [ -z "$DB_INSTANCE_IDENTIFIER" ] || [ -z "$REGION" ]; then
  RESULT=$(printf '{"metric":"%s","type":"gauge","period_in_seconds":%s,"unit":"%s","results":[]}' "$METRIC" "$PERIOD" "$UNIT")
  echo "$RESULT"
  exit 0
fi

if [[ ! "$REGION" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]]; then
  echo "ERROR: '${REGION}' from the instance hostname is not an AWS region." >&2
  exit 1
fi

if [[ ! "$DB_INSTANCE_IDENTIFIER" =~ ^[a-zA-Z][a-zA-Z0-9-]{0,62}$ ]]; then
  echo "ERROR: '${DB_INSTANCE_IDENTIFIER}' is not a valid DB instance identifier." >&2
  exit 1
fi

AWS_PROFILE_VAL=$(aws_profile_from_values)
if [ -n "$AWS_PROFILE_VAL" ]; then
  export AWS_PROFILE="$AWS_PROFILE_VAL"
fi

if ! RESPONSE=$(aws cloudwatch get-metric-statistics \
  --region "$REGION" \
  --namespace AWS/RDS \
  --metric-name "$METRIC" \
  --dimensions "Name=DBInstanceIdentifier,Value=${DB_INSTANCE_IDENTIFIER}" \
  --start-time "$START_TIME" \
  --end-time "$END_TIME" \
  --period "$PERIOD" \
  --statistics "$STATISTIC" \
  --output json); then
  echo "ERROR: CloudWatch rejected the ${METRIC} query for ${DB_INSTANCE_IDENTIFIER} in ${REGION}." >&2
  exit 1
fi

RESULT=$(printf '%s' "$RESPONSE" | jq -c \
  --arg metric "$METRIC" \
  --arg unit "$UNIT" \
  --arg statistic "$STATISTIC" \
  --arg db_instance_identifier "$DB_INSTANCE_IDENTIFIER" \
  --argjson period "$PERIOD" \
  '{
    metric: $metric,
    type: "gauge",
    period_in_seconds: $period,
    unit: $unit,
    results: [{
      selector: {db_instance_identifier: $db_instance_identifier},
      data: ([(.Datapoints // [])[] | {timestamp: .Timestamp, value: .[$statistic]}] | sort_by(.timestamp))
    }]
  }')

echo "$RESULT"
