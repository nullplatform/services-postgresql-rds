#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# build_context — Extracts variables from the NP notification context and
# prepares the Terraform execution environment for service actions.
#
# For link actions, also extracts LINK_* variables consumed by
# build_permissions_context in the next workflow step.
# ---------------------------------------------------------------------------

# --- Parse service context --------------------------------------------------

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')
SERVICE_SLUG=$(echo "$CONTEXT" | jq -r '.service.slug // .service.name // ""')

# Merge .service.attributes with action .parameters.
# CRITICAL: On the first "create" action, .service.attributes is empty or incomplete.
# The user-provided values are in .parameters. The jq * operator merges objects
# with the right-hand side taking precedence, so parameters always win.
SERVICE_ATTRS=$(echo "$CONTEXT" | jq -r '(.service.attributes // {}) * (.parameters // {})')

INSTANCE_CLASS=$(echo "$SERVICE_ATTRS"   | jq -r '.instance_class    // "db.t3.micro"')
ALLOCATED_STORAGE=$(echo "$SERVICE_ATTRS" | jq -r '.allocated_storage // 20')
POSTGRES_VERSION=$(echo "$SERVICE_ATTRS"  | jq -r '.postgres_version  // "16"')
SECRET_KMS_KEY_ID=$(echo "$SERVICE_ATTRS" | jq -r '.secret_kms_key_id // ""')
ACTION_TYPE=$(echo "$CONTEXT" | jq -r '.type // ""')

# --- Read static config from values.yaml ------------------------------------
# CRITICAL: $VALUES is a FILE PATH set by "np service workflow exec --values <path>",
# NOT JSON content. Use yaml_value() to read individual keys.
yaml_value() {
  local key="$1" default="$2" file="$3"
  local val
  val=$(grep "^${key}:" "$file" 2>/dev/null | sed 's/^[^:]*: *//;s/^"//;s/"$//' | head -1)
  echo "${val:-$default}"
}

AWS_PROFILE_VAL=$(yaml_value "aws_profile" "" "$VALUES")

if [ -n "${AWS_PROFILE_VAL}" ] && [ -z "${AWS_PROFILE:-}" ]; then
  export AWS_PROFILE="${AWS_PROFILE_VAL}"
fi

# --- Resolve AWS context from nullplatform provider -------------------------

ENTITY_NRN=$(echo "$CONTEXT" | jq -r '.entity_nrn // .service.nrn // ""')

if [ -z "$ENTITY_NRN" ]; then
  echo "ERROR: could not read the service NRN from .entity_nrn or .service.nrn in context" >&2
  exit 1
fi

DIMENSIONS=$(echo "$CONTEXT" | jq -r '
  if (.service.dimensions | type) == "object" and ((.service.dimensions | length) > 0)
  then [ .service.dimensions | to_entries[] | "\(.key):\(.value)" ] | join(",")
  else empty end')

if ! type -t provider_attributes >/dev/null 2>&1; then
provider_attributes() {
  local category="$1" nrn="$2" dimensions="$3"
  np provider list \
    --nrn "$nrn" \
    --categories "$category" \
    ${dimensions:+--dimensions "$dimensions"} \
    --format json \
    | jq -c '(.results // [])[0].attributes // {}'
}
fi

echo "Resolving region and VPC for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}"

REGION=$(provider_attributes "cloud-providers" "$ENTITY_NRN" "$DIMENSIONS" | jq -r '.account.region // ""')

if [ -z "$REGION" ]; then
  echo "ERROR: no cloud-providers provider with account.region found for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}" >&2
  exit 1
fi

echo "Using region: ${REGION}"
export REGION

VPC_ATTRIBUTES=$(provider_attributes "vpc" "$ENTITY_NRN" "$DIMENSIONS")
VPC_ID=$(echo "$VPC_ATTRIBUTES" | jq -r '.vpc.id // ""')
SUBNET_IDS=$(echo "$VPC_ATTRIBUTES" | jq -c '.vpc.subnets // []')

if [ -z "$VPC_ID" ]; then
  echo "ERROR: no vpc provider with vpc.id found for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}" >&2
  exit 1
fi

echo "Using VPC: ${VPC_ID}"

SUBNET_COUNT=$(echo "$SUBNET_IDS" | jq 'length')

if [ "$SUBNET_COUNT" -eq 0 ]; then
  echo "ERROR: the vpc provider for ${ENTITY_NRN} has no vpc.subnets; list the private subnets the database should use" >&2
  exit 1
fi

if [ "$SUBNET_COUNT" -lt 2 ]; then
  echo "ERROR: the vpc provider for ${ENTITY_NRN} lists ${SUBNET_COUNT} subnet in vpc.subnets; RDS needs at least two, in different availability zones" >&2
  exit 1
fi

echo "Using subnets: ${SUBNET_IDS}"

# --- Resolve where the tofu state lives -------------------------------------
# RDS_POSTGRES_S3_STATE_BUCKET names an existing bucket holding the state of every
# service instance, each under its own key prefix. The service never creates
# buckets and assumes nothing about the bucket's name.

if [ -z "${RDS_POSTGRES_S3_STATE_BUCKET:-}" ]; then
  echo "ERROR: RDS_POSTGRES_S3_STATE_BUCKET is not set." >&2
  echo "       Set it on the agent to the name of an existing S3 bucket that holds" >&2
  echo "       the tofu state for every instance of this service." >&2
  exit 1
fi

TFSTATE_BUCKET="$RDS_POSTGRES_S3_STATE_BUCKET"
TFSTATE_KEY_PREFIX="services/rds-postgres/${SERVICE_ID}/"

if ! aws s3api head-bucket --bucket "$TFSTATE_BUCKET" --region "$REGION" >/dev/null 2>&1; then
  echo "ERROR: the state bucket ${TFSTATE_BUCKET} does not exist or is not reachable from ${REGION}." >&2
  exit 1
fi

echo "Using state bucket: ${TFSTATE_BUCKET} (prefix ${TFSTATE_KEY_PREFIX})"

export TFSTATE_BUCKET TFSTATE_KEY_PREFIX

# --- Set Terraform execution variables --------------------------------------

export OUTPUT_DIR="/tmp/np-service-${SERVICE_ID}"
mkdir -p "$OUTPUT_DIR"

kms_key_from_state() {
  local bucket="$1" key="$2" region="$3" destination="$4" error

  if ! error=$(aws s3 cp "s3://${bucket}/${key}" "$destination" --region "$region" 2>&1 >/dev/null); then
    if [[ "$error" == *"(404)"* || "$error" == *"NoSuchKey"* || "$error" == *"does not exist"* ]]; then
      return 2
    fi
    echo "$error" >&2
    return 1
  fi

  if ! jq -e 'type == "object"' "$destination" >/dev/null 2>&1; then
    echo "s3://${bucket}/${key} is not a valid tofu state" >&2
    return 1
  fi

  jq -r '
    [.resources[]? | select(.mode == "managed")] as $resources
    | ($resources | map(select(.type == "aws_db_instance" and .name == "main")) | .[0].instances[0].attributes.kms_key_id // "") as $instance_key
    | if $instance_key == "" then ""
      elif ($resources | any(.type == "aws_kms_key" and .name == "rds")) then "managed"
      else $instance_key end' "$destination"
}

STATE_STATUS=0
STATE_INSTANCE_NAME=""
STATE_KMS_KEY=$(kms_key_from_state "$TFSTATE_BUCKET" "${TFSTATE_KEY_PREFIX}terraform.tfstate" "$REGION" "$OUTPUT_DIR/previous-state.json") || STATE_STATUS=$?

if [ "$STATE_STATUS" -eq 1 ]; then
  echo "ERROR: could not read the tofu state at s3://${TFSTATE_BUCKET}/${TFSTATE_KEY_PREFIX}terraform.tfstate" >&2
  exit 1
fi

if [ "$STATE_STATUS" -eq 2 ] && [ "$ACTION_TYPE" = "update" ] && [ "${ACTION_SOURCE:-}" != "link" ]; then
  echo "ERROR: there is no tofu state at s3://${TFSTATE_BUCKET}/${TFSTATE_KEY_PREFIX}terraform.tfstate; refusing to update an instance whose name and resources are unknown" >&2
  exit 1
fi

if [ "$STATE_STATUS" -eq 0 ]; then
  STATE_INSTANCE_NAME=$(jq -r '
    [.resources[]? | select(.mode == "managed")] as $resources
    | [
        ($resources[] | select(.type == "aws_db_instance" and .name == "main") | .instances[0].attributes.identifier),
        ($resources[] | select(.type == "aws_db_subnet_group" and .name == "main") | .instances[0].attributes.name),
        ($resources[] | select(.type == "aws_security_group" and .name == "rds") | .instances[0].attributes.name // "" | ltrimstr("np-rds-")),
        ($resources[] | select(.type == "aws_secretsmanager_secret" and .name == "master") | .instances[0].attributes.name // "" | ltrimstr("nullplatform/rds/") | rtrimstr("/master")),
        ($resources[] | select(.type == "aws_kms_alias" and .name == "rds") | .instances[0].attributes.name // "" | ltrimstr("alias/nullplatform-rds-"))
      ]
    | map(select(. != null and . != "")) | .[0] // ""' "$OUTPUT_DIR/previous-state.json")
  STATE_VPC_ID=$(jq -r '[.resources[]? | select(.mode == "managed" and .type == "aws_security_group" and .name == "rds")][0].instances[0].attributes.vpc_id // ""' "$OUTPUT_DIR/previous-state.json")
  STATE_REGION=$(jq -r '[.resources[]? | select(.mode == "managed" and .type == "aws_db_instance" and .name == "main")][0].instances[0].attributes.arn // "" | split(":") | .[3] // ""' "$OUTPUT_DIR/previous-state.json")

  if [ -n "$STATE_VPC_ID" ] && [ "$STATE_VPC_ID" != "$VPC_ID" ]; then
    echo "WARNING: the vpc provider resolves ${VPC_ID}, but this instance lives in ${STATE_VPC_ID}; keeping ${STATE_VPC_ID} so the instance is not replaced." >&2
    VPC_ID="$STATE_VPC_ID"
  fi

  STATE_SUBNET_IDS=$(jq -c '[.resources[]? | select(.mode == "managed" and .type == "aws_db_subnet_group" and .name == "main")][0].instances[0].attributes.subnet_ids // [] | sort' "$OUTPUT_DIR/previous-state.json")

  if [ "$STATE_SUBNET_IDS" != "[]" ] && [ "$STATE_SUBNET_IDS" != "$(echo "$SUBNET_IDS" | jq -c 'sort')" ]; then
    echo "WARNING: the vpc provider resolves subnets ${SUBNET_IDS}, but this instance uses ${STATE_SUBNET_IDS}; keeping them so the instance is not replaced." >&2
    SUBNET_IDS="$STATE_SUBNET_IDS"
  fi

  if [ -n "$STATE_REGION" ] && [ "$STATE_REGION" != "$REGION" ]; then
    echo "WARNING: the cloud-providers provider resolves ${REGION}, but this instance lives in ${STATE_REGION}; keeping ${STATE_REGION}." >&2
    REGION="$STATE_REGION"
    export REGION
  fi
fi

if ! type -t instance_name_for >/dev/null 2>&1; then
instance_name_for() {
  local slug="$1" service_id="$2" label max_label

  label=$(echo "$slug" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
  if [ -z "$label" ]; then
    echo "ERROR: cannot name the instance: the service has no slug or name" >&2
    return 1
  fi

  if [[ ! "$label" =~ ^[a-z] ]]; then
    label="db-${label}"
  fi

  max_label=$((63 - 1 - ${#service_id}))
  label="${label:0:$max_label}"
  while [[ "$label" == *- ]]; do
    label="${label%-}"
  done

  echo "${label}-${service_id}"
}
fi

if [ -n "$STATE_INSTANCE_NAME" ]; then
  echo "Keeping instance name ${STATE_INSTANCE_NAME} from the tofu state"
  INSTANCE_NAME="$STATE_INSTANCE_NAME"
else
  if [ -z "$SERVICE_SLUG" ]; then
    SERVICE_SLUG=$(np service read --id "$SERVICE_ID" --format json | jq -r '.slug // .name // ""')
  fi
  INSTANCE_NAME=$(instance_name_for "$SERVICE_SLUG" "$SERVICE_ID")
fi

echo "Using instance name: ${INSTANCE_NAME}"

case "$STATE_KMS_KEY" in
  managed) KMS_KEY_ARN="" ;;
  "")
    KMS_KEY_ARN=""
    if [ "$ACTION_TYPE" = "create" ]; then
      KMS_KEY_ARN="${RDS_POSTGRES_KMS_KEY_ARN:-}"
    fi
    ;;
  *) KMS_KEY_ARN="$STATE_KMS_KEY" ;;
esac

if [ -n "$KMS_KEY_ARN" ] && [[ ! "$KMS_KEY_ARN" =~ ^arn:aws[a-z-]*:kms:[a-z0-9-]+:[0-9]{12}:key/[A-Za-z0-9-]+$ ]]; then
  echo "ERROR: '${KMS_KEY_ARN}' is not a KMS key ARN (arn:aws:kms:<region>:<account>:key/<id>)" >&2
  exit 1
fi

jq -n --argjson subnet_ids "$SUBNET_IDS" '{subnet_ids: $subnet_ids}' > "$OUTPUT_DIR/network.auto.tfvars.json"

export TOFU_MODULE_DIR="$SERVICE_PATH/deployment"

export TOFU_INIT_VARIABLES="-backend-config=bucket=${TFSTATE_BUCKET} -backend-config=key=${TFSTATE_KEY_PREFIX}terraform.tfstate -backend-config=region=${REGION}"

TOFU_VARIABLES="-var=service_id=${SERVICE_ID} -var=instance_name=${INSTANCE_NAME} -var=region=${REGION} -var=vpc_id=${VPC_ID} -var=instance_class=${INSTANCE_CLASS} -var=allocated_storage=${ALLOCATED_STORAGE} -var=postgres_version=${POSTGRES_VERSION}"

# Omit the -var entirely when unset, rather than passing an empty string —
# the Terraform variable defaults to null, which is what makes AWS fall back
# to the aws/secretsmanager managed key. A "" value would instead fail as an
# invalid KMS key ID.
if [ -n "$SECRET_KMS_KEY_ID" ]; then
  TOFU_VARIABLES="${TOFU_VARIABLES} -var=secret_kms_key_id=${SECRET_KMS_KEY_ID}"
fi

if [ -n "$KMS_KEY_ARN" ]; then
  echo "Using external KMS key for storage: ${KMS_KEY_ARN}"
  TOFU_VARIABLES="${TOFU_VARIABLES} -var=kms_key_arn=${KMS_KEY_ARN}"
fi

export TOFU_VARIABLES

# --- Extract link context (link workflows only) -----------------------------
# These are consumed by build_permissions_context in the next workflow step.

if [ "${ACTION_SOURCE:-}" = "link" ]; then
  export LINK_ID=$(echo "$CONTEXT"   | jq -r '.link.id       // ""')
  export LINK_NAME=$(echo "$CONTEXT" | jq -r '.link.name     // ""')
  export SCOPE_ID=$(echo "$CONTEXT"  | jq -r '.link.scope.id // ""')
  export SCOPE_NRN=$(echo "$CONTEXT" | jq -r '.link.scope.nrn // ""')

  LINK_ATTRS=$(echo "$CONTEXT" | jq -r '(.link.attributes // {}) * (.parameters // {})')
  export LINK_ACCESS_LEVEL=$(echo "$LINK_ATTRS" | jq -r '.access_level // "read-write"')
fi
